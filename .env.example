# TypeSafe API key for JEV. Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# OpenAI API key. Used as the decision fallback and for editorial suggestions.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model for the OpenAI Decisions API (only gpt-6-luna is supported today)
OPENAI_DECISIONS_MODEL=gpt-6-luna

# Model for editorial suggestions ("System Two") through the Responses API
OPENAI_LLM_MODEL=gpt-6-astra

# Milliseconds the primary decision provider (JEV) gets before falling back to OpenAI
DECISION_TIMEOUT_MS=4000
