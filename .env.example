# TypeSafe API key for JEV. Get one at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# OpenAI API key. Used as the decision fallback and for editorial suggestions.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Milliseconds the primary decision provider (JEV) gets before falling back to OpenAI
DECISION_TIMEOUT_MS=4000

# Directory where the SQLite database (users, sessions, brands) is stored. Defaults to ./data.
# In Docker/Coolify it is /app/data; mount a persistent volume there.
DATA_DIR=

# Optional daily usage limits (UTC day). Unset keeps the default; 0 blocks the bucket.
# Defaults: decisions 20000/user 200000/global, llm 300/3000, images 30/300.
# DAILY_LIMIT_DECISIONS_USER=
# DAILY_LIMIT_DECISIONS_GLOBAL=
# DAILY_LIMIT_LLM_USER=
# DAILY_LIMIT_LLM_GLOBAL=
# DAILY_LIMIT_IMAGES_USER=
# DAILY_LIMIT_IMAGES_GLOBAL=
